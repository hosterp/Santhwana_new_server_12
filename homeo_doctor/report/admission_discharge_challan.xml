                        <!-- Signature Section with larger font -->
                        <div style="border: 2px solid black; padding: 10px; border-radius: 8px; margin-top: 10px;">
                            <div class="row mt-5">
                                <div class="col-4 text-left">
                                    <p style="font-size: 20px; margin-top: 10px;">Advance:
                                        <span t-esc="o.amount_in_advance"/>
                                    </p>
                                </div>
                                <div class="col-4 text-center">
                                    <p style="font-size: 20px; margin-top: 10px;">Discount :
                                        <span t-esc="o.discount"/>
                                    </p>
                                </div>
                                <div class="col-4 text-center">
                                    <strong>
                                        <p style="font-size: 20px; margin-top: 10px;">Grand Total :
                                            <span t-esc="o.admission_total_amount"/>
                                        </p>
                                    </strong>
                                </div>
