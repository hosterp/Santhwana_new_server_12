        <record id="fast_moving_medicine_paperformat" model="report.paperformat">
            <field name="name">Fast Moving Medicine PDF Format</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="orientation">Portrait</field>
            <field name="header_line" eval="False"/>
        </record>
        <report
                id="action_report_fast_moving"
                string="Fast Moving Medicines"
                model="fast.moving.medicine.form"
                report_type="qweb-pdf"
                name="homeo_doctor.report_fast_moving_pdf"
                file="homeo_doctor.report_fast_moving_pdf"
                print_report_name="'Fast Moving Medicines'"
                paperformat="fast_moving_medicine_paperformat"
        />
        <report
                id="action_report_fast_moving_monthly"
                string="Medicine Monthly Sales"
                model="fast.moving.medicine.monthly.form"
                report_type="qweb-pdf"
                name="homeo_doctor.report_fast_moving_monthly_pdf"
                file="homeo_doctor.report_fast_moving_monthly_pdf"
                print_report_name="'Medicine Monthly Sales'"
                paperformat="fast_moving_medicine_paperformat"
        />
        <report
                id="action_report_fast_moving_selected_monthly"
                string="Selected Medicine Monthly Sales"
                model="fast.moving.medicine.selected.monthly.form"
                report_type="qweb-pdf"
                name="homeo_doctor.report_fast_moving_selected_monthly_pdf"
                file="homeo_doctor.report_fast_moving_selected_monthly_pdf"
                print_report_name="'Selected Medicine Monthly Sales'"
                paperformat="fast_moving_medicine_paperformat"
        />


