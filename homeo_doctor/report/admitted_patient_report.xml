<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Minimal Layout for Admitted Patient Discharge Summary -->
        <template id="report_admitted_patient_details_pdf">
            <t t-call="web.basic_layout">
                <t t-if="not request.env.context.get('no_auto_print')">
                    <script type="text/javascript">
                        window.onload = function() {
                        window.print();
                        };
                    </script>
                </t>

                <t t-foreach="docs" t-as="doc">
                    <main>
                        <style>
                            @media print {
                            @page {
                            size: A4 portrait;
                            margin: 5mm 7mm 5mm 7mm; /* top, right, bottom, left */
                            }
                            }
                            .page {
                            width: 210mm;
                            height: 297mm;
                            padding: 10mm;
                            box-sizing: border-box;
                            }
                        </style>

                        <div class="page" style="font-size: 16px; color: #000;">
                            <div style="max-width: 1000px; margin: 0 auto; display: flex; align-items: center; margin-bottom: 10px; font-family: Arial, sans-serif;">
                                <div style="flex: 0 0 60px; margin-right: 10px;">
                                    <img src="/web/binary/company_logo" alt="Logo"
                                         style="max-height: 150px; max-width:150px; border-radius: 50%;"/>
                                </div>


                                <div style="flex-grow: 1; text-align: center;">
                                    <h1 style="font-size: 20px; margin: 0; font-weight: bold; color: #2c3e50;">
                                        SANTHWANA HOSPITAL
                                    </h1>


                                    <p style="margin: 2px 0; font-size: 20px; color: #555;">
                                        N.C.C Road,Ambalamukku,Trivandrum-695005
                                    </p>
                                    <p style="margin: 2px 0; font-size: 20px; color: #555;">
                                        Phone: 0471-2432121,Mob:9188429198
                                    </p>
                                    <p style="margin: 2px 0; font-size:20px; color: #555;">
                                        Email: santhwanatvpm@gmail.com
                                    </p>
                                    <p style="margin: 2px 0; font-size: 20px; color: #555;">
                                        NABH Pre Accredited Hospital | ISO 9001-2015 CERTIFIED
                                    </p>
                                </div>
                            </div>

                            <!-- Pharmacy-style Header -->
                            <!--                            <div style="max-width: 700px; margin: 0 auto; display: flex; align-items: center; margin-bottom: 10px; font-family: Arial, sans-serif;">-->
                            <!-- Logo -->
                            <!--                                <div style="flex: 0 0 60px; margin-right: 10px;">-->
                            <!--                                    <img src="/web/binary/company_logo" alt="Logo"-->
                            <!--                                         style="max-height: 60px; border-radius: 50%;"/>-->
                            <!--                                </div>-->

                            <!--                                &lt;!&ndash; Hospital Details &ndash;&gt;-->
                            <!--                                <div style="flex-grow: 1; text-align: center;">-->
                            <!--                                    <h1 style="font-size: 22px; margin: 0; font-weight: bold; color: #2c3e50;">-->
                            <!--                                        SANTHWANA HOSPITAL-->
                            <!--                                    </h1>-->
                            <!--                                    <p style="margin: 2px 0; font-size: 14px; color: #555;">-->
                            <!--                                        N.C.C Road, Ambalamukku111, Trivandrum-695005-->
                            <!--                                    </p>-->
                            <!--                                    <p style="margin: 2px 0; font-size: 14px; color: #555;">-->
                            <!--                                        Phone: 0471-2432121, 4223131-->
                            <!--                                    </p>-->
                            <!--                                    <p style="margin: 2px 0; font-size: 14px; color: #555;">-->
                            <!--                                        Email: info@santhwanahospital.com / Website: www.santhwanahospital.com-->
                            <!--                                    </p>-->
                            <!--                                    <p style="margin: 2px 0; font-size: 14px; color: #555;">-->
                            <!--                                        NABH Pre Accredited Hospital | ISO 9001-2015 CERTIFIED-->
                            <!--                                    </p>-->
                            <!--                                    <p style="margin: 2px 0; font-size: 14px; color: #555;">-->
                            <!--                                        D.L. NOS: 1-378/20-2002, 1-379/21-2002-->
                            <!--                                    </p>-->
                            <!--                                </div>-->
                            <!--                            </div>-->

                            <!-- Discharge Summary Heading -->
                            <h4 style="
                                text-align: center;
                                margin-top: 15px;
                                font-size: 18px;
                                font-weight: bold;
                                border-top: 2px solid #2c3e50;
                                border-bottom: 2px solid #2c3e50;
                                padding: 4px 0;
                                margin-bottom: 10px;
                            ">
                                Discharge Summary
                            </h4>

                            <!-- Patient Info -->
                            <table style="width: 100%; border-collapse: collapse; margin: 10px 0;">
                                <tr>
                                    <td style="padding: 5px 0;">
                                        <strong>IP No:</strong>
                                        <span t-field="doc.patient_id"/>
                                    </td>
                                    <td style="padding: 5px 0;">
                                        <strong>Name of Patient:</strong>
                                        <span t-field="doc.name"/>
                                    </td>
                                    <td style="padding: 5px 0;">
                                        <strong>Age/Sex:</strong>
                                        <span t-field="doc.age"/>
                                        /
                                        <span t-field="doc.gender"/>
                                    </td>
                                </tr>
                            </table>

                            <!-- Admission/Surgery/Discharge -->
                            <table style="width: 100%; border-collapse: collapse; margin: 10px 0;">
                                <tr>
                                    <td style="padding: 5px 0;">
                                        <strong>Admission Date:</strong>
                                        <span t-field="doc.admission_date"/>
                                    </td>
                                    <td style="padding: 5px 0;">
                                        <strong>Surgery Date:</strong>
                                        <span t-field="doc.surgery_date"/>
                                    </td>
                                    <td style="padding: 5px 0;">
                                        <strong>Discharge Date:</strong>
                                        <span t-field="doc.discharge_date"/>
                                    </td>
                                </tr>
                            </table>

                            <!-- Sections -->
                            <div style="margin-top: 8px;">

                                <p style="font-weight: bold; margin-bottom: 3px;">Reason for Admission</p>
                                <p style="margin: 0 0 8px 10px;">
                                    <span t-field="doc.reason_for_admission"/>
                                </p>
                                
                                <p style="font-weight: bold; margin-bottom: 3px;">Diagnosis</p>
                                <p style="margin: 0 0 8px 10px;">
                                    <span t-field="doc.final_diagnosis"/>
                                </p>



                                <p style="font-weight: bold; margin-bottom: 3px;">Surgery</p>
                                <p style="margin: 0 0 8px 10px;">
                                    <span t-field="doc.surgery"/>
                                </p>

                                <p style="font-weight: bold; margin-bottom: 3px;">History</p>
                                <p style="margin: 0 0 8px 10px;">
                                    <span t-field="doc.history"/>
                                </p>

                                <p style="font-weight: bold; margin-bottom: 3px;">Clinical Finding</p>
                                <p style="margin: 0 0 8px 10px;">
                                    <span t-field="doc.clinical_findings"/>
                                </p>

                                <p style="font-weight: bold; margin-bottom: 3px;">Relevant Investigation</p>
                                <p style="margin: 0 0 8px 10px;">
                                    <span t-field="doc.relevant_investigation"/>
                                </p>

                                <p style="font-weight: bold; margin-bottom: 3px;">Surgery / Operation Details</p>
                                <p style="margin: 0 0 8px 10px;">
                                    <span t-field="doc.surgery_detail"/>
                                </p>

                                <p style="font-weight: bold; margin-bottom: 3px;">Course in the Hospital</p>
                                <p style="margin: 0 0 8px 10px;">
                                    <span t-field="doc.course_of_hospital"/>
                                </p>

                                <p style="font-weight: bold; margin-bottom: 3px;">Advice on Discharge</p>
                                <p style="margin: 0 0 8px 10px;">
                                    <span t-field="doc.advice_on_discharge"/>
                                </p>

                                <!-- Doctor & Emergency -->
                                <table style="width: 100%; border-collapse: collapse; margin-bottom: 10px;">
                                    <tr>
                                        <td style="padding: 5px;">
                                            <strong>Next Visit:</strong>
                                            <p style="margin: 0 0 8px 10px;">
                                                <span t-field="doc.next_visit"/>
                                            </p>
                                        </td>

                                    </tr>
                                    <tr>
                                        <td style="padding: 5px;">
                                            <strong>Attending Doctor:</strong>
                                            <p style="margin: 0 0 8px 10px;">
                                                <span t-field="doc.attending_doctor"/>
                                            </p>
                                        </td>

                                    </tr>
                                    <tr>
                                        <td style="height:150px;"></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 5px;">
                                            <strong>Incase of any Emergency to Contact:</strong>
                                            <p style="margin: 0 0 8px 10px;">
                                                <span t-field="doc.Emergency_no"/>
                                            </p>
                                        </td>

                                    </tr>
                                </table>


                            </div>
                        </div>
                    </main>
                </t>
            </t>
        </template>

        <!-- Paperformat -->
        <record id="admission_billing_paperformat" model="report.paperformat">
            <field name="name">Admission Billing PDF Format</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="orientation">Portrait</field>
            <field name="header_line" eval="False"/>
        </record>

        <!-- Report Action -->
        <record id="action_admitted_patient_report" model="ir.actions.report">
            <field name="name">Admitted Patient Details</field>
            <field name="model">hospital.admitted.patient</field>
            <field name="report_type">qweb-html</field> <!-- changed to HTML for auto print -->
            <field name="report_name">homeo_doctor.report_admitted_patient_details_pdf</field>
            <field name="report_file">homeo_doctor.report_admitted_patient_details_pdf</field>
            <field name="print_report_name">'Admitted Patient Details'</field>
            <field name="paperformat_id" ref="admission_billing_paperformat"/>
        </record>
    </data>
</odoo>
