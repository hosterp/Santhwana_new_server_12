                            <div style="flex: 1 0 33.33%; text-align: center;">
                                <strong style="font-size: 25px;">
                                    <t t-esc="(o.mode_pay or '').upper()"/>

                                </strong>

                                <strong style="font-size: 25px;">BILL</strong>
                            </div>
                            <div style="flex: 1 0 33.33%; text-align: right;">
                                <strong style="font-size: 25px;">Bill No:</strong>
                                <span style="font-size: 25px;">
                                    <t t-esc="o.bill_number"/>
                                </span>
                            </div>
                        </div>

                        <hr style="border: 1px solid #000; margin: 10px 0;"/>
                        <!-- Second Block: Patient Info (same column layout) -->
                        <table style="width: 100%; border-collapse: collapse; font-size: 25px; margin-bottom: 10px;">
                            <tbody>
                                <!-- Row 1 -->
                                <tr>
                                    <td style="width: 33.33%; text-align: left; padding: 8px;font-size: 25px;">
                                        <strong style="font-size: 25px;">UHID:</strong>
                                        <t t-esc="o.mrd_no.display_name"/>
                                    </td>
                                    <td style="width: 33.33%; text-align: center; padding: 8px;font-size: 25px;">
                                        <strong style="font-size: 25px;">Doctor:</strong>
                                        <t t-esc="o.doctor.display_name"/>
                                        <t t-if="o.doctor and o.doctor.department_id">
                                            (
                                            <t t-esc="o.doctor.department_id.display_name"/>
                                            )
                                        </t>
                                    </td>
                                    <td style="width: 33.33%; text-align: right; padding: 8px;font-size: 25px;">
                                        <strong style="font-size: 25px;">Date:</strong>
                                        <span t-field="o.bill_date" t-options='{"format": "dd/MM/yyyy"}'/>
                                    </td>
                                </tr>
                                <!-- Row 2 -->
                                <tr>
                                    <td style="width: 33.33%; text-align: left; padding: 8px;font-size: 25px;">
                                        <strong style="font-size: 25px;">Patient:</strong>
                                        <t t-esc="o.patient_name"/>
                                        (
                                        <t t-esc="str(o.age) + '/' + dict(o._fields['gender'].selection).get(o.gender, '')"/>
                                        )
                                    </td>
                                    <td style="width: 33.33%; text-align: center; padding: 8px;font-size: 25px;">
                                        <strong style="font-size: 25px;"></strong>
                                        <!--                                            <t t-esc="doc.phone_number"/>-->
                                    </td>
                                    <td style="width: 33.33%; text-align: right; padding: 8px;font-size: 25px;">
                                        <strong style="font-size: 25px;">Mode of Payment:</strong>
                                        <t t-if="o.payment_method_split">
                                            <t t-set="modes" t-value="[]"/>
                                            <t t-if="o.cash_amount &gt; 0" t-set="modes" t-value="modes + ['CASH']"/>
                                            <t t-if="o.card_amount &gt; 0" t-set="modes" t-value="modes + ['CARD']"/>
                                            <t t-if="o.upi_amount &gt; 0" t-set="modes" t-value="modes + ['UPI']"/>
                                            <t t-esc="', '.join(modes)"/>
                                        </t>
                                        <t t-else="">
                                            <t t-esc="o.mode_pay.upper()"/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <table style="width: 100%; border-collapse: collapse; margin-top: 40px; font-size: 25px;">
                            <thead>
                                <tr style="border-bottom: 1px solid #000;font-size: 25px;">
                                    <th style="padding: 8px; width: 10%; text-align: left; font-size: 25px;">SL No
                                    </th>
                                    <th style="padding: 8px; width: 60%; text-align: left;font-size: 25px; text-align: center;">
                                        PARTICULARS
                                    </th>
                                    <!--                                <th style="padding: 8px; width: 60%; text-align: left;font-size: 25px;">-->
                                    <!--                                    QUANTITY-->
                                    <!--                                </th>-->
                                    <th style="padding: 8px; width: 30%; text-align: right;font-size: 25px;">
                                        AMOUNT(₹)
                                    </th>
                                </tr>
                            </thead>
                            <tbody style="font-size: 25px;line-height: 70px;">
                                <t t-set="slno" t-value="0"/>
                                <t t-foreach="o.general_bill_line_ids" t-as="line">
                                    <t t-set="slno" t-value="slno + 1"/>
                                    <tr>
                                        <td style="font-size: 25px; padding: 8px; ">
                                            <t t-esc="slno"/>
                                        </td>
                                        <td style="font-size: 25px; padding: 8px; text-align: center;">
                                            <t t-esc="line.particulars.name"/>
                                        </td>

                                        <!--                                    <td style="font-size: 25px; padding: 8px;">-->
                                        <!--                                        <t t-esc="line.quantity"/>-->
                                        <!--                                    </td>-->
                                        <td style="font-size: 25px; padding: 8px; text-align: right;">
                                            <t t-esc="line.rate"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tr style="margin-top: 15px;"/>
                            <tfoot style="border-top: 1px solid #000;">
                                <tr style="background-color: #f1f1f1 !important;">
                                    <td colspan="2" style="padding: 8px; text-align: left; border-top: 2px solid #000; background-color: #f1f1f1 !important;">
                                        <div style="font-size: 22px;">
                                            <strong>Amount in Words:</strong>
                                            <span t-esc="o.amount_in_words" style="text-transform: capitalize;"/>
                                        </div>
                                    </td>
                                    <td style="padding: 10px; text-align: right; border-top: 2px solid #000; background-color: #f1f1f1 !important;">
                                        <div t-if="o.payment_method_split" style="font-size: 20px; font-weight: bold; margin-bottom: 5px;">
                                            <t t-if="o.cash_amount &gt; 0"> Cash: ₹ <t t-esc="o.cash_amount"/> </t>
                                            <t t-if="o.card_amount &gt; 0"> | Card: ₹ <t t-esc="o.card_amount"/> </t>
                                            <t t-if="o.upi_amount &gt; 0"> | UPI: ₹ <t t-esc="o.upi_amount"/> </t>
                                        </div>
                                        <div style="font-size: 28px; font-weight: bold;">
                                            Total: ₹ <t t-esc="o.total_amount"/>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>


                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 51px; font-size: 25px;line-height: 97px;">
                            <div style="text-align: left; font-weight: bold;">Prepared By :
                                <t t-esc="o.staff_name.display_name"/>
                            </div>
                            <div style="text-align: center; font-weight: bold; flex-grow: 1;">Checked By</div>
                            <div style="text-align: right; font-weight: bold;">Cashier</div>
                        </div>
                    </div>
                </t>
            </main>
        </t>
    </template>

    <!-- Paper Format -->
    <record id="paperformat_a5" model="report.paperformat">
        <field name="name">A5</field>
        <field name="default" eval="False"/>
        <field name="format">A5</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>


    <!-- Report Action -->
    <report
            id="report_audiology_bill_report"
            string="Audiology Bill"
            model="audiology.billing"
            report_type="qweb-html"
            name="homeo_doctor.report_audiology_Bill"
            file="homeo_doctor.report_audiology_Bill"
            paperformat="homeo_doctor.paperformat_a5"
    />

    <report
            id="report_audiology_bill_report_a5"
            string="Audiology Bill A5"
            model="audiology.billing"
            report_type="qweb-html"
            name="homeo_doctor.report_audiology_normal_a5_challan"
            file="homeo_doctor.report_audiology_normal_a5_challan"
            paperformat="homeo_doctor.paperformat_a5"


    />
</odoo>
