<odoo>
    <template id="report_audiology_Bill">
        <t t-call="web.html_container">
            <t t-if="not request.env.context.get('no_auto_print')">
                <script type="text/javascript">
                    window.onload = function() {
                    setTimeout(function() {
                    window.print();
                    }, 500);
                    };
                </script>
            </t>
            <t t-foreach="docs" t-as="o">
                <style>
                    @media print {
                    @page {
                    size: A5 portrait;
                    margin: 5mm;
                    }

                    html, body {
                    width: 100%;
                    margin: 0;
                    padding: 0;
                    font-family: "Courier New", Courier, monospace; /* ✅ Courier New */
                    }

                    .page {
                    padding: 5mm;
                    width: 100%;
                    box-sizing: border-box;
                    font-size: 14px;
                    font-family: "Courier New", Courier, monospace; /* ✅ Courier New */
                    }

                    h1, h2, h3, p, td, th {
                    font-family: "Courier New", Courier, monospace; /* ✅ Courier New */
                    }

                    h1 { font-size: 18px; }
                    h2 { font-size: 16px; }
                    h3 { font-size: 14px; }
                    p, td, th { font-size: 12px; }
                    }

                    table {
                    width: 100%;
                    border-collapse: collapse;
                    margin-top: 10px;
                    font-size: 12px;
                    font-family: "Courier New", Courier, monospace; /* ✅ Courier New */
                    }

                    th {
                    background: #007bff;
                    color: black;
                    padding: 6px;
                    text-align: left;
                    font-size: 12px;
                    font-family: "Courier New", Courier, monospace; /* ✅ Courier New */
                    }

                    td {
                    padding: 6px;
                    border-bottom: 1px solid #ddd;
                    font-size: 12px;
                    font-family: "Courier New", Courier, monospace; /* ✅ Courier New */
                    }

                    tr:nth-child(even) {
                    background: #f9f9f9;
                    }

                    tfoot td {
                    font-weight: bold;
                    background: #f1f1f1;
                    font-size: 12px;
                    font-family: "Courier New", Courier, monospace; /* ✅ Courier New */
                    }
                </style>


                <div class="page" style="padding: 15px; font-family: Arial, sans-serif; font-size: 25px;">

                    <div style="display: flex; align-items: center; margin-bottom: 10px;">
                        <div style="flex: 0 0 120px; margin-right: 15px;">
                            <img src="/web/binary/company_logo" alt="Logo"
                                 style="max-height: 150px; max-width: 150px; border-radius: 50%;"/>
                        </div>
                        <div style="flex-grow: 1; text-align: center;">
                            <h1 style="font-size: 22px; margin: 0; font-weight: bold; color: #2c3e50;">
                                SANTHWANA HOSPITAL
                            </h1>


                            <p style="margin: 2px 0; font-size: 14px; color: #555;">
                                N.C.C Road,Ambalamukku,Trivandrum-695005
                            </p>
                            <p style="margin: 2px 0; font-size: 14px; color: #555;">
                                Phone: 0471-2432121,4223131
                            </p>
                            <p style="margin: 2px 0; font-size: 14px; color: #555;">
                                Email:info@santhwanahospital.com / Website:www.santhwanahospital.com
                            </p>
                            <p style="margin: 2px 0; font-size: 14px; color: #555;">
                                NABH Pre Accredited Hospital | ISO 9001-2015 CERTIFIED
                            </p>

                            <!--                                <h2 style="font-size: 18px; margin: 0; font-weight: bold; color: #2c3e50;">-->
                            <!--                                    GST NO :32AAICS1884P1ZS | CIN:U85110KL997PTC011813-->
                            <!--                                </h2>-->

                        </div>
                    </div>

                    <hr style="border: 1px solid #000; margin: 10px 0;"/>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px;">
                        <div style="flex: 1; text-align: left; font-weight: bold;font-size: 25px;">DEPARTMENT:
                            <t t-esc="o.department.display_name"/>
                        </div>
                        <div style="flex: 1; text-align: center; font-weight: bold;font-size: 25px;">
                            <t t-esc="o.mode_pay.upper()"/>
                            BILL
                        </div>
                        <div style="flex: 1; text-align: right; font-weight: bold;font-size: 25px;">Bill No:
                            <t t-esc="o.bill_number"/>
                        </div>
                    </div>

                    <hr style="border: 1px solid #000; margin: 10px 0;"/>
                    <div style="display: flex; justify-content: space-between; margin-top: 20px;  font-size: 25px;">
                        <div>
                            <p style="font-size: 25px;">
                                <strong>UHID:</strong>
                                <t t-esc="o.mrd_no.display_name"/>
                            </p>
                            <p>
                                <p style="font-size: 25px;">
                                    <strong>Patient Name:</strong>
                                    <t t-esc="o.patient_name"/>
                                    <span style="margin-left: 10px;">(
                                        <t t-esc="str(o.age) + '/' + dict(o._fields['gender'].selection).get(o.gender, '')"/>
                                        )
                                    </span>
                                </p>

                            </p>
                            <p style="font-size: 25px;">
                                <strong>Doctor:</strong>
                                <t t-esc="o.doctor.display_name"/>
                                <t t-if="o.doctor and o.doctor.department_id">
                                    (
                                    <t t-esc="o.doctor.department_id.display_name"/>
                                    )
                                </t>
                            </p>
                        </div>
                        <div style="text-align: right;">
                            <p style="font-size: 25px; ">
                                <strong>Date &amp; Time:</strong>
                                <t t-esc="o.bill_date"/>
                            </p>
                            <p style="font-size: 25px;">
                                <strong>Mode of Payment:</strong>
                                <strong>
                                    <t t-if="o.payment_method_split">
                                        <t t-set="modes" t-value="[]"/>
                                        <t t-if="o.cash_amount &gt; 0" t-set="modes" t-value="modes + ['CASH']"/>
                                        <t t-if="o.card_amount &gt; 0" t-set="modes" t-value="modes + ['CARD']"/>
                                        <t t-if="o.upi_amount &gt; 0" t-set="modes" t-value="modes + ['UPI']"/>
                                        <t t-esc="', '.join(modes)"/>
                                    </t>
                                    <t t-else="">
                                        <t t-esc="o.mode_pay.upper()"/>
                                    </t>
                                </strong>
                            </p>
                            <!--                            <p style="font-size: 25px;">-->
                            <!--                                <strong>Mobile:</strong>-->
                            <!--                                <t t-esc="o.mobile"/>-->
                            <!--                            </p>-->
                        </div>
                    </div>

                    <!-- Table -->
                    <table style=" font-size: 25px;">
                        <thead>
                            <tr style="border-bottom: 1px solid #000;">
                                <th style="width: 5%;font-size: 25px;">Sl No</th>
                                <th style="width: 40%;font-size: 25px;">Particulars</th>
                                <th style="width: 20%;font-size: 25px;">Rate</th>
                                <th style="width: 10%;font-size: 25px;">Qty</th>
                                <th style="width: 15%;font-size: 25px;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="slno" t-value="0"/>
                            <t t-foreach="o.general_bill_line_ids" t-as="line">
                                <t t-set="slno" t-value="slno + 1"/>
                                <tr>
                                    <td style="font-size: 25px;">
                                        <t t-esc="slno"/>
                                    </td>
                                    <td style="font-size: 25px;">
                                        <t t-esc="line.particulars.name"/>
                                    </td>
                                    <td style="font-size: 25px;">
                                        <t t-esc="line.rate"/>
                                    </td>
                                    <td style="font-size: 25px;">
                                        <t t-esc="line.quantity"/>
                                    </td>
                                    <td style="font-size: 25px;">₹
                                        <t t-esc="line.total_amt"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot style="margin-top: 52px;">
                            <t t-if="o.payment_method_split">
                                <t t-if="o.cash_amount &gt; 0">
                                    <tr>
                                        <td colspan="4" style="text-align: right; padding-right: 20px; border: none; background: none; font-size: 25px; font-weight: bold;">Cash:</td>
                                        <td style="font-weight: bold; border: none; background: none; font-size: 25px;">₹ <t t-esc="o.cash_amount"/></td>
                                    </tr>
                                </t>
                                <t t-if="o.card_amount &gt; 0">
                                    <tr>
                                        <td colspan="4" style="text-align: right; padding-right: 20px; border: none; background: none; font-size: 25px; font-weight: bold;">Card:</td>
                                        <td style="font-weight: bold; border: none; background: none; font-size: 25px;">₹ <t t-esc="o.card_amount"/></td>
                                    </tr>
                                </t>
                                <t t-if="o.upi_amount &gt; 0">
                                    <tr>
                                        <td colspan="4" style="text-align: right; padding-right: 20px; border: none; background: none; font-size: 25px; font-weight: bold;">UPI:</td>
                                        <td style="font-weight: bold; border: none; background: none; font-size: 25px;">₹ <t t-esc="o.upi_amount"/></td>
                                    </tr>
                                </t>
                            </t>
                            <tr>
                                <td colspan="4">
                                    <p style="font-size: 25px;">
                                        <strong>In Words:</strong>
                                        <t t-esc="o.amount_in_words"/>
                                    </p>
                                </td>
                                <td style="font-weight: bold;font-size: 25px; border-top: 2px solid #000;">
                                    Total: ₹
                                    <t t-esc="o.total_amount"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- Footer -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px; font-size: 25px;">
                        <div style="text-align: left; font-weight: bold;">Prepared By :
                            <t t-esc="o.staff_name.display_name"/>
                        </div>
                        <div style="text-align: center; font-weight: bold; flex-grow: 1;">Checked By</div>
                        <div style="text-align: right; font-weight: bold;">Cashier</div>
                    </div>
                </div>
            </t>
        </t>
    </template>

