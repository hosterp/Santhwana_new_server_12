    <record id="paperformat_custom_bill_a3_portrait" model="report.paperformat">
        <field name="name">Custom Bill A3 Portrait</field>
        <field name="format">A3</field>
        <field name="orientation">Portrait</field>   <!-- Correct spelling -->
        <field name="margin_top">5</field>           <!-- top margin -->
        <field name="margin_bottom">5</field>        <!-- bottom margin -->
        <field name="margin_left">7</field>          <!-- left margin -->
        <field name="margin_right">7</field>         <!-- right margin -->
        <field name="header_line" eval="False"/>     <!-- hide header line -->
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_patient_appointment" model="ir.actions.report">
        <field name="name">Patient Appointment Report DMP</field>
        <field name="model">patient.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">homeo_doctor.patient_challan_revisit_template</field>
        <field name="report_file">patient_appointment_report</field>
        <field name="binding_model_id" ref="model_patient_appointment"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="homeo_doctor.paperformat_custom_bill_a3_portrait"/>
    </record>
    <record id="paperformat_custom_bill_a5_landscape" model="report.paperformat">
        <field name="name">Custom Bill A5 Landscape</field>
        <field name="format">A5</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_patient_appointment_a5_print" model="ir.actions.report">
        <field name="name">Patient Appointment Report A5</field>
        <field name="model">patient.appointment</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">homeo_doctor.report_patient_appointment_template</field>
        <field name="report_file">patient_appointment_report</field>
        <field name="binding_model_id" ref="model_patient_appointment"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="homeo_doctor.paperformat_custom_bill_a5_landscape"/>
    </record>


</odoo>