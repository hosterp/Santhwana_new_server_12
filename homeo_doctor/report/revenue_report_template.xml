<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==============================================================
         SHARED HEADER / BODY  (used by HTML view template)
    ============================================================== -->
    <template id="revenue_report_body">
        <div style="font-family:Arial,sans-serif; padding:20px; width:100%;">

                <!-- ── Hospital Header ───────────────────────────── -->
                <div style="display:flex; align-items:center; justify-content:center;
                            margin-bottom:12px; font-family:Arial,sans-serif;">
                    <img t-att-src="'/web/binary/company_logo'"
                         style="width:70px; height:70px; border-radius:50%; margin-right:16px;"/>
                    <div style="flex-grow:1; text-align:center;">
                        <h1 style="font-size:24px; margin:0; font-weight:bold; color:#2c3e50;">
                            SANTHWANA HOSPITAL
                        </h1>
                        <p style="margin:3px 0; font-size:13px; color:#555;">
                            N.C.C Road, Ambalamukku, Trivandrum – 695005
                        </p>
                        <p style="margin:3px 0; font-size:13px; color:#555;">
                            Phone: 0471-2432121, 4223131 | Email: info@santhwanahospital.com
                        </p>
                        <p style="margin:3px 0; font-size:12px; color:#777;">
                            NABH Pre Accredited Hospital | ISO 9001-2015 CERTIFIED
                        </p>
                    </div>
                </div>

                <!-- ── Report Title ───────────────────────────────── -->
                <div style="text-align:center; margin-bottom:16px;">
                    <h2 style="margin:0; font-size:18px; color:#1a3c6e; text-transform:uppercase;
                                letter-spacing:1px; border-bottom:2px solid #1a3c6e; display:inline-block;
                                padding-bottom:4px; font-weight:bold;">
                        Revenue Report
                    </h2>
                    <p style="margin:6px 0 0; font-size:13px; color:#444;">
                        Period: <strong><t t-esc="data.get('from_date')"/></strong>
                        &amp;nbsp; to &amp;nbsp;
                        <strong><t t-esc="data.get('to_date')"/></strong>
                    </p>
                </div>

                <!-- ── Single Continuous Horizontal Table ────────── -->
                <div style="overflow-x:auto; width:100%;">
                    <table style="width:100%; border-collapse:collapse; font-size:13px;
                                   font-family:Arial,sans-serif; margin-bottom:18px;">
                        <thead>
                            <tr style="background:#1a3c6e; color:#fff;">
                                <th style="padding:10px 12px; text-align:left; border:1px solid #1a3c6e; background:#1a3c6e; color:#fff; font-weight:bold; white-space:nowrap; font-size:13px;">
                                    Date
                                </th>
                                <t t-foreach="data.get('rows', [])" t-as="row">
                                    <th style="padding:10px 8px; text-align:center; border:1px solid #2980b9; background:#1a3c6e; color:#fff; font-size:12px; white-space:nowrap; font-weight:bold;">
                                        <t t-esc="row.get('date')"/>
                                    </th>
                                </t>
                                <th style="padding:10px 12px; text-align:right; border:1px solid #0d2346; background:#0d2346; color:#fff; font-weight:bold; white-space:nowrap; font-size:13px;">
                                    Grand Total (₹)
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="padding:10px 12px; font-weight:bold; border:1px solid #ccc; background:#f2f4f8; color:#1a3c6e; white-space:nowrap; font-size:13px;">
                                    Amount (₹)
                                </td>
                                <t t-foreach="data.get('rows', [])" t-as="row">
                                    <td style="padding:10px 8px; text-align:right; border:1px solid #ccc; font-size:13px; background:#fff; white-space:nowrap; font-weight:500;">
                                        <t t-esc="'{:,.2f}'.format(row.get('grand_total', 0.0))"/>
                                    </td>
                                </t>
                                <td style="padding:10px 12px; text-align:right; font-weight:bold; border:1px solid #ccc; background:#e8f0fe; color:#1a3c6e; white-space:nowrap; font-size:13px;">
                                    <t t-esc="'{:,.2f}'.format(data.get('grand_total', 0.0))"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- No data message -->
                <t t-if="not data.get('rows')">
                    <table style="width:100%; border-collapse:collapse; font-size:13px; margin-top:10px;">
                        <tr>
                            <td style="padding:14px; text-align:center; border:1px solid #ddd; color:#999;">
                                No revenue records found for the selected period.
                            </td>
                        </tr>
                    </table>
                </t>

                <!-- ── Grand Total Summary ───────────────────────── -->
                <t t-if="data.get('rows')">
                    <div style="margin-top:14px; text-align:right;">
                        <div style="display:inline-block; border:2px solid #1a3c6e; background:#f8fafc;
                                    padding:10px 22px; border-radius:6px; font-family:Arial,sans-serif;">
                            <span style="font-size:15px; font-weight:bold; color:#1a3c6e; margin-right:15px;">
                                Grand Total Revenue:
                            </span>
                            <span style="font-size:18px; font-weight:bold; color:#27ae60;">
                                ₹ <t t-esc="'{:,.2f}'.format(data.get('grand_total', 0.0))"/>
                            </span>
                        </div>
                    </div>
                </t>

        </div>
    </template>

    <!-- ==============================================================
         PDF Template (Vertical Format: Sl No | Date | Amount)
    ============================================================== -->
    <template id="revenue_report_pdf_template">
        <t t-name="homeo_doctor.revenue_report_pdf_template">
            <t t-call="web.html_container">
                <div style="font-family:Arial,sans-serif; padding:18px; width:100%;">

                    <!-- ── Hospital Header ───────────────────────────── -->
                    <div style="display:flex; align-items:center; justify-content:center;
                                margin-bottom:12px; font-family:Arial,sans-serif;">
                        <img t-att-src="'/web/binary/company_logo'"
                             style="width:70px; height:70px; border-radius:50%; margin-right:16px;"/>
                        <div style="flex-grow:1; text-align:center;">
                            <h1 style="font-size:24px; margin:0; font-weight:bold; color:#2c3e50;">
                                SANTHWANA HOSPITAL
                            </h1>
                            <p style="margin:3px 0; font-size:13px; color:#555;">
                                N.C.C Road, Ambalamukku, Trivandrum – 695005
                            </p>
                            <p style="margin:3px 0; font-size:13px; color:#555;">
                                Phone: 0471-2432121, 4223131 | Email: info@santhwanahospital.com
                            </p>
                            <p style="margin:3px 0; font-size:12px; color:#777;">
                                NABH Pre Accredited Hospital | ISO 9001-2015 CERTIFIED
                            </p>
                        </div>
                    </div>

                    <!-- ── Report Title ───────────────────────────────── -->
                    <div style="text-align:center; margin-bottom:16px;">
                        <h2 style="margin:0; font-size:18px; color:#1a3c6e; text-transform:uppercase;
                                    letter-spacing:1px; border-bottom:2px solid #1a3c6e; display:inline-block;
                                    padding-bottom:4px; font-weight:bold;">
                            Revenue Report
                        </h2>
                        <p style="margin:6px 0 0; font-size:13px; color:#444;">
                            Period: <strong><t t-esc="data.get('from_date')"/></strong>
                            &amp;nbsp; to &amp;nbsp;
                            <strong><t t-esc="data.get('to_date')"/></strong>
                        </p>
                    </div>

                    <!-- ── Vertical Data Table ────────────────────────── -->
                    <table style="width:100%; border-collapse:collapse; font-size:13px;
                                   font-family:Arial,sans-serif; margin-top:10px;">
                        <thead>
                            <tr style="background:#1a3c6e; color:#fff;">
                                <th style="padding:10px 12px; text-align:center; width:15%; border:1px solid #ddd; font-size:14px; font-weight:bold;">
                                    Sl No
                                </th>
                                <th style="padding:10px 12px; text-align:center; width:45%; border:1px solid #ddd; font-size:14px; font-weight:bold;">
                                    Date
                                </th>
                                <th style="padding:10px 12px; text-align:right; width:40%; border:1px solid #ddd; font-size:14px; font-weight:bold;">
                                    Grand Total (₹)
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data.get('rows', [])" t-as="row">
                                <tr t-att-style="'background:#f9f9f9;' if row_index % 2 == 0 else 'background:#fff;'">
                                    <td style="padding:9px 12px; text-align:center; border:1px solid #ddd; font-size:13px;">
                                        <t t-esc="row.get('sl_no')"/>
                                    </td>
                                    <td style="padding:9px 12px; text-align:center; border:1px solid #ddd; font-size:13px;">
                                        <t t-esc="row.get('date')"/>
                                    </td>
                                    <td style="padding:9px 12px; text-align:right; border:1px solid #ddd; font-size:13px; font-weight:500;">
                                        <t t-esc="'{:,.2f}'.format(row.get('grand_total', 0.0))"/>
                                    </td>
                                </tr>
                            </t>

                            <t t-if="not data.get('rows')">
                                <tr>
                                    <td colspan="3" style="padding:14px; text-align:center; border:1px solid #ddd; color:#999; font-size:13px;">
                                        No revenue records found for the selected period.
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr style="background:#e8f0fe; font-weight:bold;">
                                <td colspan="2" style="padding:10px 12px; text-align:right; border:1px solid #ddd; color:#1a3c6e; font-size:14px;">
                                    Grand Total
                                </td>
                                <td style="padding:10px 12px; text-align:right; border:1px solid #ddd; color:#1a3c6e; font-size:15px; font-weight:bold;">
                                    <t t-esc="'{:,.2f}'.format(data.get('grand_total', 0.0))"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                </div>
            </t>
        </t>
    </template>

    <!-- ==============================================================
         HTML (View) Template
    ============================================================== -->
    <template id="revenue_report_html_template">
        <t t-name="homeo_doctor.revenue_report_html_template">
            <t t-call="web.html_container">
                <t t-call="homeo_doctor.revenue_report_body">
                    <t t-set="data" t-value="data"/>
                </t>
            </t>
        </t>
    </template>

</odoo>
