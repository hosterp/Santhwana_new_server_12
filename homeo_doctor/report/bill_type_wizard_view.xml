<odoo>
    <data>
        <record id="view_bill_type_wizard" model="ir.ui.view">
            <field name="name">bill.type.wizard.form</field>
            <field name="model">bill.type.wizard</field>
            <field name="arch" type="xml">
                <form string="Select Bill Type">
                    <group>
                        <field name="bill_type"/>
                    </group>
                    <footer>
                        <button string="Open Report" type="object" name="action_open_report" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_bill_type_wizard" model="ir.actions.act_window">
            <field name="name">Bills</field>
            <field name="res_model">bill.type.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
    <menuitem id="menu_collection_root" name="Collection Report" parent="menu_homeo_head" sequence="23"/>
    <menuitem id="menu_unsettled_collection_root" name="UnSettled Bills" parent="menu_collection_root"/>

    <menuitem id="menu_bill_type_wizard"
              name="Bills"
              parent="menu_unsettled_collection_root"
              action="action_bill_type_wizard"/>

</odoo>