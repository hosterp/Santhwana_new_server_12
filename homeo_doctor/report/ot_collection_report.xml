        <record id="view_ot_collection_report_wizard_form" model="ir.ui.view">
            <field name="name">ot.collection.report.wizard.form</field>
            <field name="model">ot.collection.report.wizard</field>
            <field name="arch" type="xml">
                <form string="OT Collection Report">
                    <group col="3">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="doctor_id"/>
                    </group>


                    <!--                    <field name="report_line_ids" nolabel="1">-->
                    <!--                        <tree editable="bottom" default_order="doctor_name">-->
                    <!--                            <field name="doctor_name"/>-->
                    <!--                            <field name="bill_name"/>-->
                    <!--                            <field name="patient_name"/>-->
                    <!--                            <field name="bill_date"/>-->
                    <!--                            <field name="amount" sum="Total"/>-->
                    <!--                        </tree>-->
                    <!--                    </field>-->

                    <footer>
                        <button string="Show Report" type="object" name="action_show_report" class="btn-primary"/>
                        <button string="Print Report" type="object" name="action_print_report" class="btn-success"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="view_ot_billing_line_form" model="ir.ui.view">
            <field name="name">ot.billing.line.form</field>
            <field name="model">ot.billing.line.wizard</field>
            <field name="arch" type="xml">
                <form string="OT Billing Line">
                    <sheet>
                        <group>
                            <field name="doctor_name"/>
                            <field name="bill_name"/>
                            <field name="mrd_no"/>
                            <field name="patient_name"/>
                            <field name="bill_date"/>
                            <field name="amount"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Print Report"
                                type="object"
                                name="action_print_report_from_line"
                                class="btn-success"/>
                        <button string="Close"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_ot_billing_line_tree" model="ir.ui.view">
            <field name="name">ot.billing.line.tree</field>
            <field name="model">ot.billing.line.wizard</field>
            <field name="arch" type="xml">
                <tree string="OT Billing Lines">
                    <field name="doctor_name"/>
                    <field name="mrd_no"/>
                    <field name="bill_name"/>
                    <field name="patient_name"/>
                    <field name="bill_date"/>
                    <field name="amount" sum="Total"/>
                </tree>
            </field>
        </record>
        <record id="view_ot_billing_line_search" model="ir.ui.view">
            <field name="name">ot.billing.line.wizard.search</field>
            <field name="model">ot.billing.line.wizard</field>
            <field name="arch" type="xml">
                <search string="OT Billing Lines">
                    <field name="doctor_name"/>
                    <field name="bill_name"/>
                    <field name="patient_name"/>
                    <field name="bill_date"/>

                    <!-- Default group by Doctor -->
                    <group expand="0" string="Group By">
                        <filter string="Doctor" name="group_doctor" context="{'group_by':'doctor_name'}"/>
                        <filter string="Bill" name="group_bill" context="{'group_by':'bill_name'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_ot_collection_report_wizard" model="ir.actions.act_window">
            <field name="name">OT Collection Report</field>
            <field name="res_model">ot.collection.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_collection_root" name="Collection Report" parent="menu_homeo_head" sequence="23"/>
        <menuitem id="menu_ot_collection_report"
                  name="OT Collection Report"
                  parent="menu_collection_root"
                  action="action_ot_collection_report_wizard" sequence="1"/>


    </data>
</odoo>