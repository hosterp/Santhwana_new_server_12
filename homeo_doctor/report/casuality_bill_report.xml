                                        <td style="padding-left:4cm;width:50%">
                                            <t t-esc="line.particulars.particular_name"/>
                                        </td>
                                        <td style="padding-right:22.5cm;width: 80%;">
                                            <t t-esc="line.total_amt"/>
                                        </td>
                                    </tr>
                                    <!--                                    <tr>-->
