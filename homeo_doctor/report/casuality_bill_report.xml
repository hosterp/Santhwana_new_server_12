    <template id="Casualty_challan_template">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.html_container">
                <main>
                    <div style="font-size:18px; color:#000;">

                        <!-- Patient Info Table -->
                        <div style="padding-top:1cm;padding-left:5cm; font-size:18px;">

                            <table style="width:100%; font-size:18px; border-collapse: collapse;">
                                <tr>
