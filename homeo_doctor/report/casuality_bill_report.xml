                                    <!--                                            <t t-esc="o.register_total_amount"/>-->
                                    <!--                                        </td>-->
                                    <!--                                    </tr>-->
                                </t>
                            </table>
                            <br style="margin-top:1cm;">
                                <table style="width: 111%;border-collapse: collapse;font-size:18px;margin-top: 100px;">
                                    <tr style="font-weight:bold;">
                                        <td style="padding-left:4cm;width:50%"></td>
                                        <td style="padding-right: 21.5cm;width: 40%;">
                                            <t t-esc="o.total_amount"/>
                                        </td>
                                    </tr>
                                </table>
                            </br>
                        </div>


                    </div>
                </main>
            </t>
        </t>
