<odoo>
    <data>
        <template id="report_patient_normala5_challan">
            <t t-call="web.html_container">
                <t t-if="not request.env.context.get('no_auto_print')">
                    <script type="text/javascript">
                        window.onload = function() {
                        setTimeout(function() {
                        window.print();
                        }, 500);
                        };
                    </script>
                </t>
                <main>
                    <t t-foreach="docs" t-as="doc">
                        <style>
                            @media print {
                            @page {
                            size: A3 landscape;
                            margin: 5mm 5mm;
                            }

                            body, .page {
                            font-size: 25px;
                            }

                            h1 { font-size: 32px; }
                            h2 { font-size: 26px; }
                            h3 { font-size: 22px; }
                            th, td, p, strong {
                            font-size: 18px;
                            }
                            }

                            /* For screen preview (HTML view) */
                            .page {
                            font-size: 25px;
                            }

                            th {
                            font-weight: bold;
                            }
                        </style>

                        <div class="page"
                             style="font-family: Arial, sans-serif; font-size: 25px; color: #2c3e50; padding: 10mm 15mm;">

                            <div style="max-width: 1000px; margin: 0 auto; display: flex; align-items: center; margin-bottom: 10px; font-family: Arial, sans-serif;">
                                <div style="flex: 0 0 60px; margin-right: 10px;">
                                    <img src="/web/binary/company_logo" alt="Logo"
                                         style="max-height: 200px; max-width: 200px; border-radius: 50%;"/>
                                </div>


                                <div style="flex-grow: 1; text-align: center;">
                                    <h1 style="font-size: 25px; margin: 0; font-weight: bold; color: #2c3e50;">
                                        SANTHWANA HOSPITAL
                                    </h1>


                                    <p style="margin: 2px 0; font-size: 25px; color: #555;">
                                        N.C.C Road,Ambalamukku,Trivandrum-695005
                                    </p>
                                    <p style="margin: 2px 0; font-size: 25px; color: #555;">
                                        Phone: 0471-2432121,Mob:9188429198
                                    </p>
                                    <p style="margin: 2px 0; font-size:25px; color: #555;">
                                        Email: santhwanatvpm@gmail.com
                                    </p>
                                    <p style="margin: 2px 0; font-size: 25px; color: #555;">
                                        NABH Pre Accredited Hospital | ISO 9001-2015 CERTIFIED
                                    </p>
                                    <!--                                <h2 style="font-size: 18px; margin: 0; font-weight: bold; color: #2c3e50;">-->
                                    <!--                                    GST NO :32AAICS1884P1ZS | CIN:U85110KL997PTC011813-->
                                    <!--                                </h2>-->

                                </div>
                            </div>


                            <hr style="border: 1px solid #000; margin: 10px 0;margin-top: 86px;"/>

                            <!-- First Row: Department / Mode of Payment / Bill No -->
                            <div style="display: flex; flex-wrap: wrap; font-size: 25px; margin-bottom: 10px;">
                                <div style="flex: 1 0 33.33%; text-align: left;">
                                    <strong style="font-size: 25px;">DEPARTMENT:</strong>
                                    <strong style="font-size: 25px;">IP</strong>
                                </div>
                                <div style="flex: 1 0 33.33%; text-align: center;">
                                    <strong style="font-size: 25px;">
                                        <t t-if="not doc.payment_method_split">
                                            <t t-esc="doc.payment_mode.upper()"/>
                                        </t>
                                    </strong>
                                    <strong style="font-size: 25px;">BILL</strong>
                                </div>
                                <div style="flex: 1 0 33.33%; text-align: right;">
                                    <strong style="font-size: 25px;">Bill No:</strong>
                                    <span style="font-size: 25px;">
                                        <t t-esc="doc.bill_number"/>
                                    </span>
                                </div>
                            </div>

                            <hr style="border: 1px solid #000; margin: 10px 0;"/>
                            <!-- Second Block: Patient Info (same column layout) -->
                            <table style="width: 100%; border-collapse: collapse; font-size: 25px; margin-bottom: 10px;">
                                <tbody>
                                    <!-- Row 1 -->
                                    <tr>
                                        <td style="width: 33.33%; text-align: left; padding: 8px;font-size: 25px;">
                                            <strong style="font-size: 25px;">UHID:</strong>
                                            <t t-esc="doc.uhid.reference_no"/>
                                        </td>
                                        <td style="width: 33.33%; text-align: center; padding: 8px;font-size: 25px;">
                                            <strong style="font-size: 25px;">Doctor:</strong>
                                            <t t-esc="doc.uhid.doctor.name"/>
                                            <t t-if="doc.uhid.doctor.name and doc.uhid.doctor.department_id">
                                                (<t t-esc="doc.uhid.doctor.department_id.display_name"/>)
                                            </t>
                                        </td>
                                        <td style="width: 33.33%; text-align: right; padding: 8px;font-size: 25px;">
                                            <strong style="font-size: 25px;">Date:</strong>
                                            <t t-esc="doc.date.strftime('%d/%m/%Y')"/>
                                        </td>
                                    </tr>
                                    <!-- Row 2 -->
                                    <tr>
                                        <td style="width: 33.33%; text-align: left; padding: 8px;font-size: 25px;">
                                            <strong style="font-size: 25px;">Patient:</strong>
                                            <t t-esc="doc.patient_name"/>
                                            (<t t-esc="doc.uhid.age"/>/<t
                                                t-esc="doc.uhid.gender.upper() if doc.uhid.gender else ''"/>)
                                        </td>
                                        <td style="width: 33.33%; text-align: center; padding: 8px;font-size: 25px;">
                                            <strong style="font-size: 25px;"></strong>
                                            <!--                                            <t t-esc="doc.phone_number"/>-->
                                        </td>
                                        <td style="width: 33.33%; text-align: right; padding: 8px;font-size: 25px;">
                                            <strong style="font-size: 25px;">Mode of Payment:</strong>
                                            <t t-if="doc.payment_method_split">
                                                <t t-set="modes" t-value="[]"/>
                                                <t t-if="doc.cash_amount &gt; 0" t-set="modes" t-value="modes + ['CASH']"/>
                                                <t t-if="doc.card_amount &gt; 0" t-set="modes" t-value="modes + ['CARD']"/>
                                                <t t-if="doc.upi_amount &gt; 0" t-set="modes" t-value="modes + ['UPI']"/>
                                                <t t-esc="', '.join(modes)"/>
                                            </t>
                                            <t t-else="">
                                                <t t-esc="doc.payment_mode.upper()"/>
                                            </t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <table style="width: 100%; border-collapse: collapse; margin-top: 40px; font-size: 25px;">
                                <thead>
                                    <tr style="border-bottom: 1px solid #000;font-size: 25px;">
                                        <th style="padding: 8px; width: 10%; text-align: left; font-size: 25px;">SL No
                                        </th>
                                        <th style="padding: 8px; width: 60%; text-align: left;font-size: 25px;">
                                            PARTICULARS
                                        </th>
                                        <th style="padding: 8px; width: 30%; text-align: right;font-size: 25px;">
                                            AMOUNT(₹)
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr style="font-size: 25px;">
                                        <!--                                        <td style="padding: 8px;font-size: 25px;">1</td>-->
                                        <!--                                        <td style="padding: 8px;font-size: 25px;">Registration Fee</td>-->
                                        <!--                                        <td style="padding: 8px; text-align: right;font-size: 25px;">-->
                                        <!--                                            <t t-esc="doc.registration_fee.fee"/>-->
                                        <!--                                        </td>-->
                                    </tr>
                                    <tr style="font-size: 25px;line-height: 81px;">
                                        <td style="padding: 8px;font-size: 25px;">1</td>
                                        <td style="padding: 8px;font-size: 25px;">Advance Amount</td>
                                        <td style="padding: 8px; text-align: right;font-size: 25px;">
                                            <t t-esc="doc.amount_added"/>
                                        </td>
                                    </tr>
                                </tbody>
                                <tr style="margin-top: 15px;"/>
                                <tfoot style="border-top: 1px solid #000;">
                                    <tr t-if="doc.payment_method_split">
                                        <td colspan="3" style="text-align: right; padding: 5px; font-size: 22px;">
                                            <span t-if="doc.cash_amount &gt; 0">Cash = <t t-esc="doc.cash_amount"/>, </span>
                                            <span t-if="doc.card_amount &gt; 0">Card = <t t-esc="doc.card_amount"/>, </span>
                                            <span t-if="doc.upi_amount &gt; 0">UPI = <t t-esc="doc.upi_amount"/></span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" style="padding: 8px; text-align: left;">
                                            <strong style="font-size: 25px;">Amount in Words:</strong>
                                            <span t-esc="doc.amount_to_text_indian()"
                                                  style="text-transform: capitalize; font-size: 25px;"/>
                                        </td>
                                        <td style="padding: 8px; text-align: right;">
                                            <strong style="font-size: 25px;">Total:</strong>
                                            <strong style="font-size: 25px;">
                                                <t t-esc="doc.amount_added"/>
                                            </strong>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>


                            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 51px; font-size: 25px;line-height: 97px;">
                                <div style="text-align: left; font-weight: bold;">Prepared By :
                                    <t t-esc="doc.Staff_name.display_name"/>
                                </div>
                                <div style="text-align: center; font-weight: bold; flex-grow: 1;">Checked By</div>
                                <div style="text-align: right; font-weight: bold;">Cashier</div>
                            </div>
                        </div>
                    </t>
                </main>
            </t>
        </template>

        <record id="paperformat_custom_bill_a3_portrait" model="report.paperformat">
            <field name="name">Custom Bill A3 Portrait</field>
            <field name="format">A3</field>
            <field name="orientation">Portrait</field>   <!-- Correct spelling -->
            <field name="margin_top">5</field>           <!-- top margin -->
            <field name="margin_bottom">5</field>        <!-- bottom margin -->
            <field name="margin_left">7</field>          <!-- left margin -->
            <field name="margin_right">7</field>         <!-- right margin -->
            <field name="header_line" eval="False"/>     <!-- hide header line -->
            <field name="header_spacing">10</field>
            <field name="dpi">90</field>
        </record>

        <report
                id="report_patient_wallet"
                model="patient.wallet"
                string="Advance Amount Challan/DMP"
                report_type="qweb-pdf"
                name="homeo_doctor.patient_challan_advance_wallet_template"
                file="homeo_doctor.patient_challan_advance_wallet_template"
                print_report_name="'Patient Advance Challan '"
                paperformat="paperformat_custom_bill_a3_portrait"
        />
        <report
                id="report_patient_a5_wallet"
                model="patient.wallet"
                string="Advance Amount Challan"
                report_type="qweb-html"
                name="homeo_doctor.report_patient_normala5_challan"
                file="homeo_doctor.report_patient_normala5_challan"
                print_report_name="'Patient Advance Challan '"
                paperformat="paperformat_custom_bill_a3_portrait"
        />
        <template id="patient_challan_advance_wallet_template">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <main>
                        <div style="font-size:18px; color:#000;">

                            <!-- Patient Info Table -->
                            <div style="padding-top:1cm;padding-left:5cm; font-size:18px;">

                                <table style="width:100%; font-size:18px; border-collapse: collapse;">
                                    <tr>
                                        <!-- Left Column: Name, Reference, Doctor -->
                                        <td style="width:50%; vertical-align: top;">
                                            <t t-esc="o.patient_name"/>
                                            <br/>
                                            <t t-esc="o.uhid.reference_no"/>
                                            <br/>
                                            <t t-esc="o.uhid.doctor.display_name"/>
                                        </td>

                                        <!-- Right Column: Bill No and Date -->
                                        <td style="width:50%; vertical-align: top;">
                                            <div style="position: relative; right: 4cm;">
                                                <t t-esc="o.bill_number"/>
                                                <br/>
                                                <t t-esc="o.date.strftime('%d-%m-%Y') if o.date else ''"/>
                                            </div>
                                        </td>

                                    </tr>
                                </table>

                            </div>


                            <br/>

                            <!-- Charges Table -->
                            <div style="margin-top:1cm;"> <!-- Adjust 1cm as needed -->
                                <table style="width:100%; border-collapse: collapse; font-size:18px;">
                                    <tr>
                                        <td style="padding-left:4cm;width:50%"></td>
                                        <td style="padding-right:10cm;">
                                            <!--                                            <t t-esc="o.registration_fee.display_name"/>-->
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left:4cm;">Advance Amount</td>
                                        <td style="padding-right:10cm;">
                                            <t t-esc="o.amount_added"/>
                                        </td>
                                    </tr>
                                    <!--                                    <tr style="font-weight:bold;">-->
                                    <!--                                        <td style="padding-left:10cm;">-->
                                    <!--                                            <t t-esc="o.register_total_amount"/>-->
                                    <!--                                        </td>-->
                                    <!--                                    </tr>-->
                                </table>
                                <br style="margin-top:6cm;">
                                    <table style="width:100%; border-collapse: collapse; font-size:18px;margin-top: 51px;">
                                        <tr style="font-weight:bold;">
                                            <td style="padding-left:4cm;width:50%"></td>
                                            <td style="padding-right:5cm;">
                                                <t t-esc="o.amount_added"/>
                                            </td>
                                        </tr>
                                    </table>
                                </br>
                            </div>


                        </div>
                    </main>
                </t>
            </t>
        </template>
        <record id="view_patient_wallet_search" model="ir.ui.view">
            <field name="name">patient.wallet.search</field>
            <field name="model">patient.wallet</field>
            <field name="arch" type="xml">
                <search string="Patient Wallet">
                    <field name="patient_name"/>
                    <field name="bill_number"/>
                    <field name="payment_mode"/>
                    <field name="uhid"/>
                    <field name="Staff_name"/>
                </search>
            </field>
        </record>


        <record id="view_patient_wallet_tree" model="ir.ui.view">
            <field name="name">patient.wallet.tree</field>
            <field name="model">patient.wallet</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="date"/>
                    <field name="bill_number"/>
                    <field name="uhid"/>
                    <field name="patient_name" string="Patient Name"/>
                    <field name="amount_added" string="Added Amount"/>
                    <field name="refund" string="Refund"/>
                    <field name="payment_mode"/>
                    <field name="Staff_name"/>
                    <field name="balance"/>
                    <field name="status"/>

                </tree>
            </field>
        </record>

        <record id="view_patient_wallet_form" model="ir.ui.view">
            <field name="name">patient.wallet.form</field>
            <field name="model">patient.wallet</field>
            <field name="arch" type="xml">
                <header>
                    <button name='patient_advance_DMP_new' string="Patient Challan/DMP" type="object"
                            class="oe_highlight"
                            style="text-align: center;"/>
                    <button name='patient_advance_a5_new' string="Patient Advance Challan " type="object"
                            class="oe_highlight"
                            style="text-align: center;"/>

                </header>
                <form>
                    <sheet>
                        <group col="3">
                            <group>
                                <field name="date"/>
                            </group>
                            <group>
                                <field name="uhid" options="{'no_create': True, 'no_edit': True}"/>
                            </group>
                            <group>
                                <field name="patient_name"/>
                            </group>
                            <group>
                                <field name="balance" readonly="1"/>
                            </group>

                        </group>
                        <group string="Add Cash to Wallet" col="4">
                            <group colspan="4">
                                <field name="payment_method_split"/>
                            </group>
                            <group>
                                <field name="amount_in_inr" attrs="{'readonly': [('payment_method_split', '=', True)]}"/>
                            </group>
                            <group>
                                <field name="payment_mode" attrs="{'invisible': [('payment_method_split', '=', True)]}"/>
                            </group>
                            <group>
                                <field name="Staff_name" required="1" readonly="1"/>
                            </group>
                            <group>
                                <button name="action_add_amount" type="object" string="ADD Cash"/>
                            </group>
                            <group attrs="{'invisible': [('payment_method_split', '=', False)]}">
                                <field name="cash_amount"/>
                            </group>
                            <group attrs="{'invisible': [('payment_method_split', '=', False)]}">
                                <field name="upi_amount"/>
                            </group>
                            <group attrs="{'invisible': [('payment_method_split', '=', False)]}">
                                <field name="card_amount"/>
                            </group>

                        </group>
                        <group string="Refund from Wallet" col="3"
                               groups="base.group_system,homeo_doctor.group_admin_refund">
                            <group>
                                <field name="amount_refund"/>
                            </group>
                            <group>
                                <field name="Staff_name" required="1" readonly="1"/>
                            </group>
                            <group>
                                <button name="action_refund_amount" type="object" string="Refund"/>
                            </group>

                        </group>
                        <!--                        <notebook>-->
                        <!--                            <page string="Transactions">-->
                        <!--                                <field name="line_ids">-->
                        <!--                                    <tree editable="bottom">-->
                        <!--                                        <field name="date"/>-->
                        <!--                                        <field name="amount"/>-->
                        <!--                                        <field name="type"/>-->
                        <!--                                        <field name="pay_mode"/>-->
                        <!--                                    </tree>-->
                        <!--                                </field>-->
                        <!--                                <button string="Print Wallet Statement"-->
                        <!--                                        type="object"-->
                        <!--                                        name="action_print_wallet"-->
                        <!--                                        class="btn-primary"-->
                        <!--                                        icon="fa-print" invisible="1"/>-->
                        <!--                            </page>-->
                        <!--                        </notebook>-->
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_patient_wallet" model="ir.actions.act_window">
            <field name="name">Patient Wallet</field>
            <field name="res_model">patient.wallet</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_patient_wallet_search"/>
        </record>
        <menuitem id="menu_my_patient_template_root" name="Patient Registration" parent="menu_homeo_head" sequence="2"/>
        <menuitem id="menu_patient_wallet"
                  name="Patient Wallets"
                  parent="menu_my_patient_template_root"
                  action="action_patient_wallet"
                  sequence="1"/>


    </data>
</odoo>