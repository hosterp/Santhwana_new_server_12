<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Tree view -->
        <record id="view_audiology_test_tree" model="ir.ui.view">
            <field name="name">audiology.test.tree</field>
            <field name="model">audiology.test</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="price"/>
                </tree>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_audiology_test_form" model="ir.ui.view">
            <field name="name">audiology.test.form</field>
            <field name="model">audiology.test</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group col="2">
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="price"/>
                            </group>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>


        <record id="action_audiology_test" model="ir.actions.act_window">
            <field name="name">Audiology Tests</field>
            <field name="res_model">audiology.test</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_audiology_test_tree"/>
        </record>


        <menuitem id="menu_lab_root" name="Home" parent="menu_homeo_head" sequence="11"/>
        <menuitem id="menu_audiology_test" name="Audiology Tests"
                  parent="menu_lab_root" action="action_audiology_test" sequence="26"/>

    </data>
</odoo>
